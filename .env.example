# Test admin access — change before publishing this website.
ADMIN_USER=admin@holygate.in
ADMIN_PASSWORD=HolyGateDemo#2026
PORT=3000
NODE_ENV=development

# ==============================================================================
# Supabase Cloud Database & Storage (Optional, recommended for production)
# Get these from Supabase Dashboard -> Project Settings -> API
# ==============================================================================
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=product-images

# ==============================================================================
# Amazon Product Import (Optional)
# If left empty, HolyGate uses automatic high-precision web-scraping to fetch details.
# ==============================================================================
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
